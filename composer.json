{
  "name": "brainy/laravel-error-notifier",
  "description": "Lightweight, zero-config real-time error notifier for Laravel applications (Slack & Discord).",
  "keywords": [
    "laravel",
    "error",
    "notifier",
    "slack",
    "discord",
    "monitoring",
    "exceptions"
  ],
  "homepage": "https://github.com/brainy-software/laravel-error-notifier",
  "license": "MIT",
  "authors": [
    {
      "name": "Brainy Software LLC",
      "email": "contact@brainy-software.co.jp"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "illuminate/http": "^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0",
    "phpunit/phpunit": "^10.5|^11.0",
    "phpstan/phpstan": "^1.10|^2.0"
  },
  "autoload": {
    "psr-4": {
      "Brainy\\ErrorNotifier\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Brainy\\ErrorNotifier\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Brainy\\ErrorNotifier\\ErrorNotifierServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "test": "vendor/bin/phpunit",
    "analyse": "vendor/bin/phpstan analyse"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}
